  <diagram id="turnover" name="Turnover stress">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="&lt;b&gt;HCMM: change of the Cauchy stress of a constituent by mass turnover&lt;/b&gt; during \(ds\), with \(\mathbf F\) and \(\mathbf F_g\) fixed" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="deg" value="degraded \(-\dot\varrho_-\,ds\)&lt;br&gt;at stress \(\boldsymbol\sigma\)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sur" value="surviving \(\varrho + \dot\varrho_-\,ds\)&lt;br&gt;at stress \(\boldsymbol\sigma\)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="220" height="160" as="geometry" />
        </mxCell>
        <mxCell id="l_old" value="&lt;b&gt;constituent at \(s\)&lt;/b&gt;&lt;br&gt;mass \(\varrho\), stress \(\boldsymbol\sigma\)" style="text;html=1;align=center;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="plus" value="+" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;" vertex="1" parent="1">
          <mxGeometry x="300" y="225" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="new" value="deposited \(\dot\varrho_+\,ds\)&lt;br&gt;at prestress \(\boldsymbol\sigma_{pre}\)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="360" y="240" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="l_new" value="&lt;b&gt;new mass&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="340" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="res" value="mass \(\varrho + \dot\varrho\,ds\)&lt;br&gt;&lt;br&gt;stress = mass average&lt;br&gt;\(\boldsymbol\sigma(s+ds)\)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#efe6f4;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="700" y="150" width="260" height="180" as="geometry" />
        </mxCell>
        <mxCell id="l_res" value="&lt;b&gt;constituent at \(s + ds\)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="340" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="eq" value="\(\boldsymbol\sigma(s+ds) = \dfrac{\boldsymbol\sigma_{pre}\,\dot\varrho_{+}ds + \boldsymbol\sigma\,(\varrho + \dot\varrho_{-}ds)}{\varrho + \dot\varrho\,ds}\),  \(\dot\varrho = \dot\varrho_+ + \dot\varrho_-\)&lt;br&gt;&lt;br&gt;\(\dot{\boldsymbol\sigma}_r\,ds = \boldsymbol\sigma(s+ds) - \boldsymbol\sigma = \dfrac{\dot\varrho_+ ds}{\varrho + \dot\varrho\,ds}(\boldsymbol\sigma_{pre} - \boldsymbol\sigma)\)  →  \(\dot{\boldsymbol\sigma}_r = -\dfrac{\dot\varrho_+}{\varrho}(\boldsymbol\sigma - \boldsymbol\sigma_{pre}) = -\left(\dfrac{\dot\varrho}{\varrho} + \dfrac{1}{T}\right)(\boldsymbol\sigma - \boldsymbol\sigma_{pre})\)  for \(\dot\varrho_- = -\varrho/T\)&lt;br&gt;&lt;br&gt;The \(\dot\varrho\,ds\) in the denominator vanishes only in the rate limit \(ds \to 0\); it does not have to be dropped: kept, \(\boldsymbol\sigma(s+ds)\) is the exact mass average and stays between \(\boldsymbol\sigma\) and \(\boldsymbol\sigma_{pre}\) for any \(ds\) (implicit form, Sempértegui &amp;amp; Avril 2023); dropped, the explicit step can overshoot for \(ds \gtrsim T\).&lt;br&gt;&lt;br&gt;&lt;b&gt;Assumptions:&lt;/b&gt; \(\mathbf F\), \(\mathbf F_g\) fixed during \(ds\); all mass increments of a constituent have the same density; its stress is the mass average over its increments; turnover changes only the average stress-free configuration, not the strain energy function." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=12;spacingRight=12;fontSize=13;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="940" height="220" as="geometry" />
        </mxCell>
        <mxCell id="a_sur" value="" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#9673a6;fontSize=13;fontColor=#9673a6;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.35;" edge="1" parent="1" source="sur" target="res">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a_new" value="mass average" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#9673a6;fontSize=13;fontColor=#9673a6;labelBackgroundColor=#ffffff;entryX=0;entryY=0.75;" edge="1" parent="1" source="new" target="res">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="euler" name="Forward vs backward Euler">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="1200" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;HCMM time integration of the remodeling: forward vs backward Euler&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="1160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="h_f" value="&lt;b&gt;Forward (explicit, staggered)&lt;/b&gt; – Maes 2023 / current code" style="text;html=1;align=left;verticalAlign=bottom;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f0" value="&lt;b&gt;1.&lt;/b&gt; Stress evaluation (every Newton iteration): \(\mathbf F_e = \mathbf F\,\mathbf F_g^{-1}\,(\mathbf F_r^n)^{-1}\) with the stored \(\mathbf F_r^n\) → \(\boldsymbol\sigma\), tangent at fixed \(\mathbf F_r^n\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#f4eef7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="560" height="85" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="&lt;b&gt;2.&lt;/b&gt; Equilibrium converged at \(\mathbf F^{n+1}\) → commit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#f4eef7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="560" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a_f1" value="" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f0" target="f1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="&lt;b&gt;3.&lt;/b&gt; \(\dot\varrho_+\) from \(\boldsymbol\sigma(\mathbf F^{n+1}, \mathbf F_r^n)\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#f4eef7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="560" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a_f2" value="" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f1" target="f2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="&lt;b&gt;4.&lt;/b&gt; Linearized Eq. 20: \(\frac{\partial\boldsymbol\sigma}{\partial\mathbf F_e}:(\mathbf F_e\mathbf L_r) = \frac{\dot\varrho_+}{\varrho}(\boldsymbol\sigma - \boldsymbol\sigma_{pre})\);  \(\mathbf F_r^{n+1} = \mathbf F_r^n + \mathbf L_r\mathbf F_r^n\,ds\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#f4eef7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="560" height="85" as="geometry" />
        </mxCell>
        <mxCell id="a_f3" value="" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f2" target="f3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="&lt;b&gt;5.&lt;/b&gt; \(\mathbf F_r^{n+1}\) enters the equilibrium only in the next step (one-step lag)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#f4eef7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="560" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a_f4" value="" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f3" target="f4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="h_b" value="&lt;b&gt;Backward (implicit, return mapping)&lt;/b&gt; – Sempértegui &amp;amp; Avril 2023" style="text;html=1;align=left;verticalAlign=bottom;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="640" y="70" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b0" value="&lt;b&gt;1.&lt;/b&gt; Stress evaluation (every Newton iteration): trial \(\boldsymbol\sigma_{tr} = \hat{\boldsymbol\sigma}(\mathbf F\,\mathbf F_g^{-1}(\mathbf F_r^n)^{-1})\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#e6f4f5;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="640" y="110" width="560" height="85" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;2.&lt;/b&gt; \(\Delta\varrho_+ = \varrho\,\frac{ds}{T}(1 + k_+\,\mathrm{rel}(\boldsymbol\sigma_{tr}))\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#e6f4f5;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="640" y="220" width="560" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a_b1" value="" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b0" target="b1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;3.&lt;/b&gt; Target (exact mass average): \(\boldsymbol\sigma^{n+1} = \dfrac{\varrho\,\boldsymbol\sigma_{tr} + \Delta\varrho_+\,\boldsymbol\sigma_{pre}}{\varrho + \Delta\varrho_+}\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#e6f4f5;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="640" y="310" width="560" height="85" as="geometry" />
        </mxCell>
        <mxCell id="a_b2" value="" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b1" target="b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;4.&lt;/b&gt; Local Newton: \(\hat{\boldsymbol\sigma}(\mathbf F\,\mathbf F_g^{-1}(\mathbf F_r^{n+1})^{-1}) = \boldsymbol\sigma^{n+1}\)&lt;br&gt;6 sym. components (compressible) | 5 dev + \(\det\mathbf F_r = 1\) (incompressible) | scalar \(\lambda_r\) (fiber)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#e6f4f5;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="640" y="420" width="560" height="85" as="geometry" />
        </mxCell>
        <mxCell id="a_b3" value="" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b2" target="b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="&lt;b&gt;5.&lt;/b&gt; \(\boldsymbol\sigma\), tangent incl. \(\partial\mathbf F_r/\partial\mathbf F\) (implicit diff., custom_root) → equilibrium; commit only stores \(\mathbf F_r^{n+1}\), \(\varrho^{n+1}\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#e6f4f5;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="640" y="530" width="560" height="85" as="geometry" />
        </mxCell>
        <mxCell id="a_b4" value="" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b3" target="b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;Update of the stress&lt;/b&gt; \(\dot{\boldsymbol\sigma} = -\frac{\dot\varrho_+}{\varrho}(\boldsymbol\sigma - \boldsymbol\sigma_{pre})\) at fixed \(\mathbf F\), \(\mathbf F_g\):&lt;br&gt;forward: \(\boldsymbol\sigma^{n+1} = \boldsymbol\sigma^n + ds\,\dot{\boldsymbol\sigma}(\boldsymbol\sigma^n) = (1-w)\,\boldsymbol\sigma^n + w\,\boldsymbol\sigma_{pre}\), \(w = \dot\varrho_+ds/\varrho\) (\(= ds/T\) in homeostasis) can exceed 1 → overshoot past \(\boldsymbol\sigma_{pre}\)&lt;br&gt;backward: \(\boldsymbol\sigma^{n+1} = \boldsymbol\sigma^n + ds\,\dot{\boldsymbol\sigma}(\boldsymbol\sigma^{n+1})\) → \(w = \Delta\varrho_+/(\varrho + \Delta\varrho_+) \in [0,1]\): always between \(\boldsymbol\sigma^n\) and \(\boldsymbol\sigma_{pre}\), unconditionally stable&lt;br&gt;&lt;br&gt;&lt;b&gt;Forward:&lt;/b&gt; cheap (one linear solve per step and constituent), but first order with one-step lag, error ≈ \(ds/(2T)\) (0.9 % at \(ds = 10\), \(T = 101\) in analytical_check) plus the linearization error of Eq. 20; needs \(ds \ll T\).&lt;br&gt;&lt;b&gt;Backward:&lt;/b&gt; nonlinear stress equation solved exactly, no overshoot, same timing as FCMM (current cohort deposited at \(s\)) → removes the first-step offset; costs a local Newton per equilibrium iteration and the tangent must include \(\partial\mathbf F_r/\partial\mathbf F\).&lt;br&gt;&lt;b&gt;In both:&lt;/b&gt; \(\varrho\) and \(\mathbf F_g\) kept lagged; making them implicit couples all constituents through \(\mathbf F_g\) (Sempértegui &amp;amp; Avril 2023, App. C–E)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=12;spacingRight=12;fontSize=12;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="1160" height="260" as="geometry" />
        </mxCell>
        <mxCell id="deriv" value="&lt;b&gt;Derivation of \(\boldsymbol\sigma(t_{n+1})\)&lt;/b&gt; (Sempértegui &amp;amp; Avril 2023, App. A, Eq. A.1 / 18)&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; Turnover at fixed \(\mathbf F\), \(\mathbf F_g\) (Cyron Eq. 11/14): \(\dot{\boldsymbol\sigma} = -\frac{\dot\rho_+}{\rho}(\boldsymbol\sigma - \boldsymbol\sigma_{pre})\)&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Backward Euler, right side at \(t_{n+1}\), \(\Delta\rho_+ = \Delta t\,\dot\rho_+\): \(\boldsymbol\sigma_{n+1} - \boldsymbol\sigma_{tr} = -\frac{\Delta\rho_+}{\rho_{k+1}}(\boldsymbol\sigma_{n+1} - \boldsymbol\sigma_{pre})\)&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Collect \(\boldsymbol\sigma_{n+1}\): \(\boldsymbol\sigma_{n+1}(\rho_{k+1} + \Delta\rho_+) = \rho_{k+1}\,\boldsymbol\sigma_{tr} + \Delta\rho_+\,\boldsymbol\sigma_{pre}\)&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; \(\boldsymbol\sigma_{n+1} = \frac{\Delta\rho_+}{\rho_{k+1} + \Delta\rho_+}\,\boldsymbol\sigma_{pre} + \frac{\rho_{k+1}}{\rho_{k+1} + \Delta\rho_+}\,\boldsymbol\sigma_{tr}\)  = Cyron's mass average with the denominator kept&lt;br&gt;\(\boldsymbol\sigma_{tr} = \hat{\boldsymbol\sigma}(\mathbf F_{n+1}\mathbf F_g^{-1}(\mathbf F_r^n)^{-1})\): after growth, before remodeling; \(\rho_{k+1}\): density after growth, before remodeling&lt;br&gt;forward instead: \(\boldsymbol\sigma_{n+1} = \boldsymbol\sigma_{tr} - \frac{\Delta\rho_+}{\rho_n}(\boldsymbol\sigma_{tr} - \boldsymbol\sigma_{pre})\), weight unbounded&lt;br&gt;&lt;b&gt;Deviatoric only (A.2–A.4):&lt;/b&gt; \(\det\mathbf F_r = 1\) → \(|\mathbf F_e|\) fixed → volumetric stress unchanged; same volumetric part of \(\boldsymbol\sigma\), \(\boldsymbol\sigma_{pre}\) postulated → only \(\boldsymbol\sigma'\) (Eq. 17). Compressible matrix (FCMM-consistent): keep the full tensor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4f5;strokeColor=#0e8088;align=left;spacingLeft=12;spacingRight=12;fontSize=12;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="920" width="1160" height="250" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="semp" name="Ours vs Sempértegui">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="840" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t_l" value="Ours: explicit, staggered (core.py)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="540" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t_r" value="Sempértegui &amp;amp; Avril: backward, monolithic per Gauss point" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="10" width="540" height="30" as="geometry" />
        </mxCell>
        <mxCell id="g" value="&lt;b&gt;Global Newton iteration&lt;/b&gt;, trial \(\mathbf F_{n+1}\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="340" y="50" width="540" height="40" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="&lt;b&gt;sigma_solver&lt;/b&gt;, state frozen:&lt;br&gt;\(\mathbf F_e^j = \mathbf F_{n+1}(\mathbf F_g^{n})^{-1}(\mathbf F_r^{j,n})^{-1}\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="540" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;local Newton&lt;/b&gt; (UMAT), all constituents at once:&lt;br&gt;\(\mathbf X = \{\mathbf C_r^j, \Delta\lambda^j, \rho^j\}\), \(\mathbf F_g(\sum_j\rho^j)\) recomputed from \(\mathbf X\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="640" y="120" width="540" height="60" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="no evolution law evaluated" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#f4eef7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="540" height="75" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="residuals per \(j\): \(R_{C_r}\) Eq. 29 (exp. map), \(R_f\) Eq. 21 with backstress Eq. 18,&lt;br&gt;\(R_\rho = \rho_{k+1} - \rho_k - \Delta t\,\dot\rho_{k+1}(\boldsymbol\sigma_{n+1})\) Eq. 33&lt;br&gt;coupling: \(\partial/\partial\rho\) columns only (Eq. 36/37, Fig. 2)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#eef4fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="640" y="200" width="540" height="75" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="\(\boldsymbol\sigma = \sum_j \frac{\rho^{j,n}}{J}\hat{\boldsymbol\sigma}^j\) = trial stress \(\boldsymbol\sigma_{tr}\)&lt;br&gt;tangent \(\partial\boldsymbol\sigma_{tr}/\partial\mathbf F\) (AD)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="295" width="540" height="55" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="\(\boldsymbol\sigma_{n+1}(\mathbf C_r^{n+1}, \rho^{n+1}, \mathbf F_g^{n+1})\)&lt;br&gt;consistent tangent by perturbation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="640" y="295" width="540" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c" value="&lt;b&gt;converged?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="535" y="370" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="&lt;b&gt;commit&lt;/b&gt; (once):&lt;br&gt;\(\dot\rho_\pm^j(\boldsymbol\sigma_{tr}, \rho^n)\) → \(\rho^{n+1}\)&lt;br&gt;Eq. 20 linearized with \((\boldsymbol\sigma_{tr} - \boldsymbol\sigma_{pre})\) → \(\mathbf F_r^{n+1}\)&lt;br&gt;then \(\rho_{tot}\), \(\mathbf F_g\), \(\phi\) → used from step \(n+2\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="540" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="accept local state as \(n+1\) (SDVs)&lt;br&gt;nothing left to update" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="640" y="470" width="540" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tab" value="&lt;table border='1' cellpadding='4' style='border-collapse:collapse;width:100%;font-size:12px'&gt;&lt;tr style='background:#eeeeee'&gt;&lt;th&gt;used in equilibrium at \(n+1\)&lt;/th&gt;&lt;th&gt;ours&lt;/th&gt;&lt;th&gt;Sempértegui&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;remodeling \(\mathbf F_r^j\)&lt;/td&gt;&lt;td&gt;&lt;b&gt;\(n\)&lt;/b&gt; (lag)&lt;/td&gt;&lt;td&gt;\(n+1\)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;mass \(\rho^j\) (stress weight)&lt;/td&gt;&lt;td&gt;&lt;b&gt;\(n\)&lt;/b&gt; (lag)&lt;/td&gt;&lt;td&gt;\(n+1\)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;\(\rho_{tot}\), \(\mathbf F_g\), \(\phi^j\)&lt;/td&gt;&lt;td&gt;&lt;b&gt;\(n\)&lt;/b&gt; (lag)&lt;/td&gt;&lt;td&gt;\(n+1\), inside local Newton&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;rates \(\dot\rho_\pm^j\)&lt;/td&gt;&lt;td&gt;\(\boldsymbol\sigma_{tr}\), \(\rho^n\) (explicit)&lt;/td&gt;&lt;td&gt;\(\boldsymbol\sigma_{n+1}\), \(\rho^{n+1}\) (Eq. 33)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;\(\boldsymbol\sigma\) in \((\boldsymbol\sigma - \boldsymbol\sigma_{pre})\)&lt;/td&gt;&lt;td&gt;\(\boldsymbol\sigma_{tr}\), linearized&lt;/td&gt;&lt;td&gt;\(\boldsymbol\sigma_{n+1}\) (Eq. 18)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;\(\mathbf F\), \(\mathbf R\), \(\boldsymbol\sigma_{pre}\)&lt;/td&gt;&lt;td&gt;\(n+1\)&lt;/td&gt;&lt;td&gt;\(n+1\)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="620" height="215" as="geometry" />
        </mxCell>
        <mxCell id="n_other" value="&lt;b&gt;other differences&lt;/b&gt; (not lag):&lt;br&gt;• S&amp;amp;A remodel deviatoric only (A.4), \(\det\mathbf F_r = 1\)&lt;br&gt;• unknown \(\mathbf C_r\) via exponential map vs. \(\mathbf F_r\) via Eq. 41/43&lt;br&gt;• \(\Delta\rho_+\) prescribed (Eq. 19) or Eq. 33 vs. Maes Eq. 24" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=left;spacingLeft=6;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="700" y="600" width="480" height="100" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;where updated&lt;/b&gt;&lt;br&gt;ours: after global convergence (&lt;b&gt;commit&lt;/b&gt;)&lt;br&gt;S&amp;amp;A: inside every global iteration (local Newton), stored on convergence" link="data:page/id,algorithm" id="n_where">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=left;spacingLeft=6;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
            <mxGeometry x="700" y="715" width="480" height="75" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="a_gl" value="" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="g" target="l1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a_gr" value="" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="g" target="r1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a_l12" value="" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="l1" target="l2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a_l23" value="" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="l2" target="l3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a_r12" value="" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="r1" target="r2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a_r23" value="" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="r2" target="r3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a_lc" value="" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="l3" target="c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a_rc" value="" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="r3" target="c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a_cl" value="yes" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c" target="l4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a_cr" value="yes" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c" target="r4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a_no" value="no: update \(\mathbf F\)" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;dashed=1;" edge="1" parent="1" source="c" target="g">
          <mxGeometry relative="1" as="geometry" />

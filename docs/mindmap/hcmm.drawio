          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hom2" value="one \(\mathbf F_{gr}^j = \mathbf F_r^j\mathbf F_g\) per constituent instead of per increment" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#f4eef7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="560" y="135" width="320" height="45" as="geometry" />

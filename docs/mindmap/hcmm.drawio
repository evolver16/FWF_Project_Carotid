        <mxCell id="grow" value="Growth \(\mathbf F_g(\rho_{tot}/\rho_{tot,0})\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">

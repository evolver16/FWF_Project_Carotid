        <mxCell id="b2" value="turnover?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="930" y="930" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="b2n" value="keep \(\rho^{j,n}\), \(\mathbf F_r^{j,n}\)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1105" y="937" width="135" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;font face='monospace'&gt;&lt;b&gt;production / removal .increment&lt;/b&gt;&lt;/font&gt;&lt;br&gt;\(\Delta\rho_\pm^j = \pm\frac{\rho^{j,n}\Delta s}{T}(1 + k_\pm\,\mathrm{rel})\), rel = sigma_f_rel(\(\sigma_f^j, \rho_{tot}^n\))" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacingLeft=10;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="780" y="1005" width="460" height="65" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="\(\rho^{j,n+1} = \rho^{j,n} + \Delta\rho_+^j + \Delta\rho_-^j\)&lt;br&gt;sigma_rate_euler \(= \frac{\Delta\rho_+^j}{\rho^{j,n}}\big(\rho_{tot}^n\hat{\boldsymbol\sigma}^j/J - \rho_{pre}\mathbf R\boldsymbol\sigma_{pre}^j\mathbf R^T\big)\)&lt;br&gt;\(\rho_{pre} = \rho_{tot}^n/J\) (deposition) or \(\rho_{tot,0}\) (initial)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="780" y="1085" width="460" height="70" as="geometry" />

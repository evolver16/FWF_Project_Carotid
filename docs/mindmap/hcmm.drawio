        <mxCell id="n_pre" value="deposition: \(\frac{J_g}{J}\mathbf R\boldsymbol\sigma^j(0)\mathbf R^T\) (\(\mathbf F_e \to \mathbf G\))&lt;br&gt;initial (Maes Eq. 17): \(\mathbf R\boldsymbol\sigma^j(0)\mathbf R^T\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;align=left;spacingLeft=6;dashed=1;fillColor=#f4eef7;strokeColor=#9673a6;" vertex="1" parent="1">

        <mxCell id="state" value="&lt;b&gt;Stored state&lt;/b&gt;&lt;br&gt;\(\rho^j\), \(\mathbf F_r^j\), \(\mathbf G^j\), \(\mathbf F_g\)&lt;br&gt;fixed size, no history" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;align=left;spacingLeft=6;dashed=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="700" y="165" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_kin" value="≈ same form as \(\mathbf F = \mathbf F_e\mathbf F_g\) (kinematic_growth.drawio)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;align=left;spacingLeft=6;dashed=1;fillColor=#e6f4f5;strokeColor=#0e8088;fontColor=#0e8088;" vertex="1" parent="1">

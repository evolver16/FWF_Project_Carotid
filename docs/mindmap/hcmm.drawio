          <mxGeometry x="30" y="430" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mot" value="&lt;b&gt;Motivation&lt;/b&gt;: CMM stores the whole history \(\mathbf F(\tau)\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">

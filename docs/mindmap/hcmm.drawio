        </UserObject>
        <mxCell id="lg_c" value="\(t_{n+1}\) (current)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">

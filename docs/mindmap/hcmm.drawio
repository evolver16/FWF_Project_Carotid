        </mxCell>
        <mxCell id="acc" value="&lt;font face='monospace'&gt;&lt;b&gt;sum&lt;/b&gt;&lt;/font&gt;&lt;br&gt;\(\boldsymbol\sigma^{(i)} \mathrel{+}= \frac{\rho^{j,n}}{J^{(i)}}\hat{\boldsymbol\sigma}^j\)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacingLeft=10;spacingRight=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="140" y="470" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="out" value="return \(\boldsymbol\sigma^{(i)}\), aux = \(\{\mathbf F_e^j, \hat{\boldsymbol\sigma}^j\}\)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="140" y="580" width="400" height="45" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;\(t_{n+1}\)&lt;/b&gt;: \(\mathbf F^{(i)}\), \(J^{(i)}\)&lt;br&gt;&lt;b&gt;\(t_n\)&lt;/b&gt; (lagged): \(\mathbf F_g^n\), \(\mathbf F_r^{j,n}\) (via \(\mathbf F_e\)), \(\rho^{j,n}\) (weight)&lt;br&gt;backward Euler: these three at \(t_{n+1}\), solved inside" link="data:page/id,euler" id="note">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=left;spacingLeft=6;dashed=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">

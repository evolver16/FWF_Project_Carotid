        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;6.&lt;/b&gt; Prestress \(\boldsymbol\sigma_{pre}^j\) from \(\mathbf G^j\), rotated with \(\mathbf R\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#f4eef7;strokeColor=#9673a6;" vertex="1" parent="1">

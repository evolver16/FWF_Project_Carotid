          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hom3" value="assumption: turnover keeps \(W^j\), changes only the mean stress-free configuration" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#f4eef7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="560" y="190" width="320" height="45" as="geometry" />

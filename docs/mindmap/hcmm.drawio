        <mxCell id="b5" value="&lt;font face='monospace'&gt;&lt;b&gt;material.F_r(\(\mathbf F_e^j, J, c\), sigma_rate_euler)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;→ \(\mathbf F_r^{j,n+1}\): Fung Eq. 41 analytic | NeoHookean Eq. 43 one linear solve | NeoHookeanInc Newton" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacingLeft=10;spacingRight=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">

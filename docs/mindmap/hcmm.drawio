        <mxCell id="msig" value="&lt;font face='monospace'&gt;&lt;b&gt;material.sigma(\(\mathbf F_e^j\))&lt;/b&gt;&lt;/font&gt;&lt;br&gt;\(\hat{\boldsymbol\sigma}^j = \frac{\partial W^j}{\partial\mathbf F_e}\mathbf F_e^T\)&lt;br&gt;only input: \(\mathbf F_e^j\) (+ params)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacingLeft=10;spacingRight=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="140" y="305" width="400" height="75" as="geometry" />
        </mxCell>
        <mxCell id="o_sig" value="\(\hat{\boldsymbol\sigma}^j\)&lt;br&gt;&lt;i&gt;mixed \(t_{n+1}\) / \(t_n\)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="240" y="400" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="i_J" value="\(J^{(i)} = \det\mathbf F^{(i)}\)&lt;br&gt;&lt;i&gt;\(t_{n+1}\)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">

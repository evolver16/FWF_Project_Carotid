          <mxGeometry x="60" y="710" width="400" height="45" as="geometry" />
        </mxCell>
        <mxCell id="b_solve" value="&lt;b&gt;sigma_solver&lt;/b&gt;&lt;br&gt;every Newton iteration,&lt;br&gt;state untouched" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;align=left;spacingLeft=6;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">

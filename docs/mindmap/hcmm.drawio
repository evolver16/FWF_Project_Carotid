        <UserObject label="Remodeling \(\dot{\boldsymbol\sigma}_r^j = -\frac{\dot\rho_+^j}{\rho^j}(\boldsymbol\sigma^j - \boldsymbol\sigma_{pre}^j) \to \mathbf F_r^j\)" link="data:page/id,turnover" id="remod">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#f4eef7;strokeColor=#9673a6;" vertex="1" parent="1">
            <mxGeometry x="775" y="45" width="330" height="45" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="t_step" value="One time step \(n \to n+1\)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="125" width="420" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1.&lt;/b&gt; Global BC at \(n+1\) → trial \(\mathbf F\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="165" width="400" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2.&lt;/b&gt; \(\mathbf F_e^j = \mathbf F\,\mathbf F_g^{-1}\,(\mathbf F_r^{j,n})^{-1}\) with stored \(\mathbf F_g^n\), \(\mathbf F_r^{j,n}\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="235" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3.&lt;/b&gt; \(\boldsymbol\sigma = \sum_j \frac{\rho^{j,n}}{J}\,\hat{\boldsymbol\sigma}^j(\mathbf F_e^j)\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="400" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4.&lt;/b&gt; BC / equilibrium fulfilled?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="160" y="380" width="200" height="85" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5.&lt;/b&gt; Mass: \(\rho^{j,n+1} = \rho^j + (\dot\rho_+^j + \dot\rho_-^j)\,ds\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#f4eef7;strokeColor=#9673a6;" vertex="1" parent="1">

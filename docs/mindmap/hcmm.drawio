        </mxCell>
        <mxCell id="b_commit" value="&lt;b&gt;commit&lt;/b&gt;&lt;br&gt;once per step,&lt;br&gt;on converged \(\mathbf F\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;align=left;spacingLeft=6;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">

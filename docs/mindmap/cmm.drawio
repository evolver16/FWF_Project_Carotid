                </mxCell>
                <mxCell id="lg_l" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" value="\(t_n\) (lagged)" vertex="1">

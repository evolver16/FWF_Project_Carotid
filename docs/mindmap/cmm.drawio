                <mxCell id="Fe" value="&lt;font face=&#39;monospace&#39;&gt;&lt;b&gt;F_e_calc&lt;/b&gt;&lt;/font&gt;&lt;br&gt;\(\mathbf F_e^j = \mathbf F^{(i)}(\mathbf F_g^n)^{-1}(\mathbf F_r^{j,n})^{-1}\)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacingLeft=10;spacingRight=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
                    <mxGeometry x="780" y="310" width="460" height="60" as="geometry"/>

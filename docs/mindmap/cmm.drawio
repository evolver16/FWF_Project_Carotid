    <diagram id="flow" name="Flow chart (code)">
        <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1520" math="1" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="One HCMM step \(n \to n+1\) in code (material_point.step / System.run)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="20" y="5" width="900" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="g_newton" value="solve_F / System.equilibrium: Newton iteration \(i\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=3;dashed=1;fillColor=none;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="280" y="225" width="980" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="g_commit" value="commit: once per step, on \(\mathbf F_{n+1}\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=3;dashed=1;fillColor=none;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="280" y="805" width="980" height="560" as="geometry"/>
                </mxCell>
                <mxCell id="g_j" value="constituent_update, per \(j\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=3;dashed=1;fillColor=none;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="760" y="835" width="490" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="init_c" value="&lt;font face=&#39;monospace&#39;&gt;&lt;b&gt;constituent(...)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;\(\mathbf F_r^{j,0} = (\mathbf G^j)^{-1}\), \(\boldsymbol\sigma_{pre}^j = \hat{\boldsymbol\sigma}^j(\mathbf G^j)\), \(\sigma_{f,pre}^j = \mathrm{tr}\,\boldsymbol\sigma_{pre}^j\)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacingLeft=10;spacingRight=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
                    <mxGeometry x="300" y="45" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="init_m" value="&lt;font face=&#39;monospace&#39;&gt;&lt;b&gt;mixture(...)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;\(\rho_{tot,0} = \sum_j\rho^{j,0}\), \(\phi^{j,0} = \rho^{j,0}/\rho_{tot,0}\), \(\mathbf F_g^0 = \mathbf I\)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacingLeft=10;spacingRight=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
                    <mxGeometry x="780" y="45" width="460" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="state" value="&lt;b&gt;state \(S^n\)&lt;/b&gt;&lt;br&gt;per \(j\): \(\rho^{j,n}\), \(\mathbf F_r^{j,n}\), \(\phi^{j,n}\), \(\sigma_f^{j,n}\) | mixture: \(\rho_{tot}^n\), \(\mathbf F_g^n\)&lt;br&gt;fixed: \(\boldsymbol\sigma_{pre}^j\), \(\sigma_{f,pre}^j\), laws" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
                    <mxGeometry x="300" y="140" width="380" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="bc" value="&lt;b&gt;\(\mathrm{BC}_{n+1}\)&lt;/b&gt;&lt;br&gt;stretch / stress / force / pressure" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
                    <mxGeometry x="20" y="140" width="200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="Fx" value="&lt;font face=&#39;monospace&#39;&gt;&lt;b&gt;F_from_x&lt;/b&gt;&lt;/font&gt;&lt;br&gt;\(\mathbf F^{(i)} = \mathbf F(\mathbf x^{(i)}, \mathrm{BC}_{n+1})\), \(\mathbf x^{(0)} = \mathbf x_n\)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacingLeft=10;spacingRight=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="300" y="255" width="380" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="sig" value="&lt;font face=&#39;monospace&#39;&gt;&lt;b&gt;sigma_solver(\(S^n, \mathbf F^{(i)}\))&lt;/b&gt;&lt;/font&gt;&lt;br&gt;\(\boldsymbol\sigma^{(i)} = \sum_j \frac{\rho^{j,n}}{J^{(i)}}\hat{\boldsymbol\sigma}^j(\mathbf F_e^j)\)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacingLeft=10;spacingRight=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">

<mxfile host="65bd71144e">
    <diagram id="mindmap" name="Overview">
        <mxGraphModel dx="1112" dy="782" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="980" math="1" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="hcmm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" value="&lt;b&gt;Constrained Mixture Model&lt;/b&gt;&lt;div&gt;&lt;b&gt;Humprhey Rajagopal 2002&lt;/b&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="60" width="210" x="10" y="12.5" as="geometry"/>
                </mxCell>
                <mxCell id="hom" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;The idea of constrained mixture theroy is that a material consisting of multiple constituents deforms uniformly with one defromation gradient F, this means interconstituent interactions can be neglected&lt;/b&gt;" vertex="1">
                    <mxGeometry height="85" width="420" x="10" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="wBruslNdQrpOLpaYggGj-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" value="&lt;b&gt;Homogenized CMM&lt;/b&gt;&lt;br&gt;(Cyron et al. 2016)" vertex="1">
                    <mxGeometry height="60" width="210" x="30" y="640" as="geometry"/>
                </mxCell>
                <mxCell id="wBruslNdQrpOLpaYggGj-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;In classical CMM every constituent has a history of mass depositions at certain current deformation gradients F(s), which degrade over time. Therefor a heridatry integral of over all simulation steps has to be built for every step&lt;/b&gt;" vertex="1">
                    <mxGeometry height="85" width="420" x="10" y="162.5" as="geometry"/>
                </mxCell>
                <UserObject label="&lt;b&gt;Mass deposited at time \(\tau\)&lt;/b&gt;&lt;br&gt;\(\mathbf F_e^j(s,\tau) = \mathbf F(s)\,\mathbf F^{-1}(\tau)\,\mathbf G^j\)&lt;br&gt;&lt;i&gt;diagram: page Constrained mixture&lt;/i&gt;" id="0QsqrzKswuEvI0QZ2M8a-2">
                    <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=20;" vertex="1">
                        <mxGeometry height="80" width="280" x="530" y="247.5" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="0QsqrzKswuEvI0QZ2M8a-5" edge="1" parent="1" source="0QsqrzKswuEvI0QZ2M8a-4" style="edgeStyle=none;html=1;" target="0QsqrzKswuEvI0QZ2M8a-2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="0QsqrzKswuEvI0QZ2M8a-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;Similar to Kinematic Growth theory the deformation gradient can be split into elastic F_e and non elastic part F(tau), G(tau), where F(tau) describes the deformation at deposition time of the cohort and G the prestress of a certain constituent&amp;nbsp;&lt;/b&gt;" vertex="1">
                    <mxGeometry height="85" width="420" x="10" y="247.5" as="geometry"/>
                </mxCell>
                <mxCell id="0QsqrzKswuEvI0QZ2M8a-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;Mass is constantly added m(s) and removed q(s) depending on various factors, even if mass is constant due to removal and generating being equal, new deposited mass may is added with a certain prestretch G that might be different from the removed mass current stress, therefor causing a change in overall stress, which is called remodeling&lt;/b&gt;" vertex="1">
                    <mxGeometry height="85" width="420" x="10" y="332.5" as="geometry"/>
                </mxCell>
                <mxCell id="0QsqrzKswuEvI0QZ2M8a-10" edge="1" parent="1" source="0QsqrzKswuEvI0QZ2M8a-8" style="edgeStyle=none;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="0QsqrzKswuEvI0QZ2M8a-9">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="0QsqrzKswuEvI0QZ2M8a-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;The helmholtz energy of the material at a certain time step is calculated with an integral over time of the exisiting mass at a certain time point where each time point has a different elastic and inelastic deformation&lt;/b&gt;" vertex="1">
                    <mxGeometry height="85" width="420" x="10" y="502.5" as="geometry"/>
                </mxCell>
                <UserObject label="&lt;b&gt;psi = integral over smth&lt;/b&gt;" id="0QsqrzKswuEvI0QZ2M8a-9">
                    <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=20;" vertex="1">
                        <mxGeometry height="80" width="280" x="530" y="502.5" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="0QsqrzKswuEvI0QZ2M8a-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=20;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;Net increase of mass, called growth also causes a stress&lt;/b&gt;" vertex="1">
                    <mxGeometry height="85" width="420" x="10" y="417.5" as="geometry"/>
                </mxCell>
                <mxCell id="0QsqrzKswuEvI0QZ2M8a-14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f8f0;strokeColor=#82b366;fontSize=12;arcSize=20;" value="We need to track the deposition and degredation of each mass at a certain current deformation F" vertex="1">
                    <mxGeometry height="70" width="280" x="900" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="0QsqrzKswuEvI0QZ2M8a-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f8f0;strokeColor=#82b366;fontSize=12;arcSize=20;" value="The tracked variables are:&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;F(tau)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;and for each constituent:&lt;br&gt;q(s,tau)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;m(tau)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;in case of growth being stress dependent&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;sigma^j(tau)&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="160" width="280" x="900" y="210" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="algorithm" name="Algorithm">
        <mxGraphModel dx="2286" dy="1203" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="780" math="1" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t_laws" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" value="Evolution laws (per constituent \(j\))" vertex="1">
                    <mxGeometry height="30" width="500" x="40" y="10" as="geometry"/>
                </mxCell>
                <mxCell id="prod" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#f4eef7;strokeColor=#9673a6;" value="Production \(\dot\rho_+^j(\boldsymbol\sigma^j)\)" vertex="1">
                    <mxGeometry height="45" width="230" x="40" y="45" as="geometry"/>
                </mxCell>
                <mxCell id="rem" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#f4eef7;strokeColor=#9673a6;" value="Removal \(\dot\rho_-^j(\boldsymbol\sigma^j)\)" vertex="1">
                    <mxGeometry height="45" width="230" x="285" y="45" as="geometry"/>
                </mxCell>
                <mxCell id="grow" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Growth \(\mathbf F_g(\rho_{tot}/\rho_{tot,0})\)" vertex="1">
                    <mxGeometry height="45" width="230" x="530" y="45" as="geometry"/>
                </mxCell>
                <UserObject label="Remodeling \(\dot{\boldsymbol\sigma}_r^j = -\frac{\dot\rho_+^j}{\rho^j}(\boldsymbol\sigma^j - \boldsymbol\sigma_{pre}^j) \to \mathbf F_r^j\)" link="data:page/id,turnover" id="remod">
                    <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#f4eef7;strokeColor=#9673a6;" vertex="1">
                        <mxGeometry height="45" width="330" x="775" y="45" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="t_step" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" value="One time step \(n \to n+1\)" vertex="1">
                    <mxGeometry height="30" width="420" x="40" y="125" as="geometry"/>
                </mxCell>
                <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#eeeeee;strokeColor=#666666;" value="&lt;b&gt;1.&lt;/b&gt; Global BC at \(n+1\) → trial \(\mathbf F\)" vertex="1">
                    <mxGeometry height="45" width="400" x="60" y="165" as="geometry"/>
                </mxCell>
                <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;2.&lt;/b&gt; \(\mathbf F_e^j = \mathbf F\,\mathbf F_g^{-1}\,(\mathbf F_r^{j,n})^{-1}\) with stored \(\mathbf F_g^n\), \(\mathbf F_r^{j,n}\)" vertex="1">
                    <mxGeometry height="50" width="400" x="60" y="235" as="geometry"/>
                </mxCell>
                <mxCell id="s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;3.&lt;/b&gt; \(\boldsymbol\sigma = \sum_j \frac{\rho^{j,n}}{J}\,\hat{\boldsymbol\sigma}^j(\mathbf F_e^j)\)" vertex="1">
                    <mxGeometry height="45" width="400" x="60" y="310" as="geometry"/>
                </mxCell>
                <mxCell id="s4" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#eeeeee;strokeColor=#666666;" value="&lt;b&gt;4.&lt;/b&gt; BC / equilibrium fulfilled?" vertex="1">
                    <mxGeometry height="85" width="200" x="160" y="380" as="geometry"/>
                </mxCell>
                <mxCell id="s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#f4eef7;strokeColor=#9673a6;" value="&lt;b&gt;5.&lt;/b&gt; Mass: \(\rho^{j,n+1} = \rho^j + (\dot\rho_+^j + \dot\rho_-^j)\,ds\)" vertex="1">
                    <mxGeometry height="45" width="400" x="60" y="500" as="geometry"/>
                </mxCell>
                <mxCell id="s6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#f4eef7;strokeColor=#9673a6;" value="&lt;b&gt;6.&lt;/b&gt; Prestress \(\boldsymbol\sigma_{pre}^j\) from \(\mathbf G^j\), rotated with \(\mathbf R\)" vertex="1">
                    <mxGeometry height="45" width="400" x="60" y="570" as="geometry"/>
                </mxCell>
                <UserObject label="&lt;b&gt;7.&lt;/b&gt; Remodeling: solve Eq. 20 → \(\mathbf F_r^{j,n+1}\)" link="data:page/id,turnover" id="s7">
                    <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#f4eef7;strokeColor=#9673a6;" vertex="1">
                        <mxGeometry height="45" width="400" x="60" y="640" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="s8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;8.&lt;/b&gt; Growth: \(\mathbf F_g^{n+1}(\rho_{tot}^{n+1})\), \(\phi^j = \rho^j/\rho_{tot}\)" vertex="1">
                    <mxGeometry height="45" width="400" x="60" y="710" as="geometry"/>
                </mxCell>
                <mxCell id="b_solve" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;align=left;spacingLeft=6;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;sigma_solver&lt;/b&gt;&lt;br&gt;every Newton iteration,&lt;br&gt;state untouched" vertex="1">
                    <mxGeometry height="120" width="170" x="490" y="235" as="geometry"/>
                </mxCell>
                <mxCell id="b_commit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;align=left;spacingLeft=6;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;commit&lt;/b&gt;&lt;br&gt;once per step,&lt;br&gt;on converged \(\mathbf F\)" vertex="1">
                    <mxGeometry height="255" width="170" x="490" y="500" as="geometry"/>
                </mxCell>
                <mxCell id="state" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;align=left;spacingLeft=6;dashed=1;fillColor=#ffffff;strokeColor=#666666;" value="&lt;b&gt;Stored state&lt;/b&gt;&lt;br&gt;\(\rho^j\), \(\mathbf F_r^j\), \(\mathbf G^j\), \(\mathbf F_g\)&lt;br&gt;fixed size, no history" vertex="1">
                    <mxGeometry height="70" width="230" x="700" y="165" as="geometry"/>
                </mxCell>
                <mxCell id="n_kin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;align=left;spacingLeft=6;dashed=1;fillColor=#e6f4f5;strokeColor=#0e8088;fontColor=#0e8088;" value="≈ same form as \(\mathbf F = \mathbf F_e\mathbf F_g\) (kinematic_growth.drawio)" vertex="1">
                    <mxGeometry height="40" width="300" x="700" y="250" as="geometry"/>
                </mxCell>
                <mxCell id="n_pre" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;align=left;spacingLeft=6;dashed=1;fillColor=#f4eef7;strokeColor=#9673a6;" value="deposition: \(\frac{J_g}{J}\mathbf R\boldsymbol\sigma^j(0)\mathbf R^T\) (\(\mathbf F_e \to \mathbf G\))&lt;br&gt;initial (Maes Eq. 17): \(\mathbf R\boldsymbol\sigma^j(0)\mathbf R^T\)" vertex="1">
                    <mxGeometry height="55" width="300" x="700" y="560" as="geometry"/>
                </mxCell>
                <UserObject label="forward (as here): 5–7 after convergence, one-step lag&lt;br&gt;backward: 5–7 inside 2–3 (local Newton), stable for any \(ds\)" link="data:page/id,euler" id="n_time">
                    <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;align=left;spacingLeft=6;dashed=1;fillColor=#f4eef7;strokeColor=#9673a6;" vertex="1">
                        <mxGeometry height="55" width="320" x="700" y="630" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="n_cmm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;align=left;spacingLeft=6;dashed=1;fillColor=#e6f4f5;strokeColor=#0e8088;fontColor=#0e8088;" value="≈ mass average as in CMM, without history (cmm.drawio)" vertex="1">
                    <mxGeometry height="40" width="300" x="700" y="700" as="geometry"/>
                </mxCell>

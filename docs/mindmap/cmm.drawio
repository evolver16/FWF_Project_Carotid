                <mxCell id="o_sig" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" value="\(\hat{\boldsymbol\sigma}^j\)&lt;br&gt;&lt;i&gt;mixed \(t_{n+1}\) / \(t_n\)&lt;/i&gt;" vertex="1">
                    <mxGeometry height="45" width="200" x="240" y="400" as="geometry"/>
                </mxCell>
                <mxCell id="i_J" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" value="\(J^{(i)} = \det\mathbf F^{(i)}\)&lt;br&gt;&lt;i&gt;\(t_{n+1}\)&lt;/i&gt;" vertex="1">
                    <mxGeometry height="45" width="180" x="600" y="410" as="geometry"/>
                </mxCell>
                <mxCell id="acc" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;spacingLeft=10;spacingRight=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;font face=&#39;monospace&#39;&gt;&lt;b&gt;sum&lt;/b&gt;&lt;/font&gt;&lt;br&gt;\(\boldsymbol\sigma^{(i)} \mathrel{+}= \frac{\rho^{j,n}}{J^{(i)}}\hat{\boldsymbol\sigma}^j\)" vertex="1">
                    <mxGeometry height="60" width="400" x="140" y="470" as="geometry"/>
                </mxCell>
                <mxCell id="out" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" value="return \(\boldsymbol\sigma^{(i)}\), aux = \(\{\mathbf F_e^j, \hat{\boldsymbol\sigma}^j\}\)" vertex="1">
                    <mxGeometry height="45" width="400" x="140" y="580" as="geometry"/>
                </mxCell>
                <UserObject label="&lt;b&gt;\(t_{n+1}\)&lt;/b&gt;: \(\mathbf F^{(i)}\), \(J^{(i)}\)&lt;br&gt;&lt;b&gt;\(t_n\)&lt;/b&gt; (lagged): \(\mathbf F_g^n\), \(\mathbf F_r^{j,n}\) (via \(\mathbf F_e\)), \(\rho^{j,n}\) (weight)&lt;br&gt;backward Euler: these three at \(t_{n+1}\), solved inside" link="data:page/id,euler" id="note">
                    <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=left;spacingLeft=6;dashed=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1">
                        <mxGeometry height="70" width="370" x="600" y="575" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="lg_c" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" value="\(t_{n+1}\) (current)" vertex="1">

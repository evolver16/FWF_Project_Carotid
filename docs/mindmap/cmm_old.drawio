                <mxCell id="cm2a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f8f0;strokeColor=#82b366;fontSize=12;arcSize=12;" value="\(\mathbf F(s)\,\mathbf F^{-1}(\tau)\): deformation of the tissue since the deposition time \(\tau\)" vertex="1">
                    <mxGeometry height="55" width="320" x="930" y="150" as="geometry"/>

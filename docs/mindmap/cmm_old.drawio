    <diagram id="cmm_steps" name="CMM – steps">
        <mxGraphModel dx="2509" dy="1346" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="1070" math="1" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;" value="&lt;b&gt;Constrained mixture model: one time step at a Gauss point&lt;/b&gt;" vertex="1">
                    <mxGeometry height="40" width="1160" x="40" y="15" as="geometry"/>
                </mxCell>
                <mxCell id="h_fe" parent="1" style="text;html=1;align=left;verticalAlign=bottom;fontSize=13;fontStyle=1;" value="FE (global)" vertex="1">
                    <mxGeometry height="30" width="230" x="40" y="70" as="geometry"/>
                </mxCell>
                <mxCell id="fe1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#eeeeee;strokeColor=#666666;" value="Time step \(s\): loads and boundary conditions" vertex="1">
                    <mxGeometry height="50" width="230" x="40" y="110" as="geometry"/>
                </mxCell>
                <mxCell id="fe2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#eeeeee;strokeColor=#666666;" value="Global Newton iteration: displacements → \(\mathbf F(s)\) at every Gauss point" vertex="1">
                    <mxGeometry height="60" width="230" x="40" y="190" as="geometry"/>
                </mxCell>
                <mxCell id="h_ev" parent="1" style="text;html=1;align=left;verticalAlign=bottom;fontSize=13;fontStyle=1;" value="Gauss point: stress evaluation (every Newton iteration)" vertex="1">
                    <mxGeometry height="30" width="480" x="340" y="150" as="geometry"/>
                </mxCell>
                <mxCell id="ev0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;1.&lt;/b&gt; For every constituent \(j\) and every stored cohort \(\tau_k \le s\): \(\mathbf F_e^j(s,\tau_k) = \mathbf F(s)\,\mathbf F^{-1}(\tau_k)\,\mathbf G^j\)" vertex="1">
                    <mxGeometry height="60" width="480" x="340" y="190" as="geometry"/>
                </mxCell>
                <mxCell id="ev1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;2.&lt;/b&gt; Survival \(q^j(s,\tau_k)\), e.g. \(e^{-(s-\tau_k)/T^j}\), and \(Q^j(s)\) for the initial mass" vertex="1">
                    <mxGeometry height="55" width="480" x="340" y="275" as="geometry"/>
                </mxCell>
                <mxCell id="ev2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;3.&lt;/b&gt; New cohort at \(s\): deposition rate \(m^j(s)\) from the stress-dependent law; it depends on \(\boldsymbol\sigma^j(s)\) → local iteration" vertex="1">
                    <mxGeometry height="60" width="480" x="340" y="355" as="geometry"/>
                </mxCell>
                <mxCell id="ev3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;4.&lt;/b&gt; Mass: \(\rho^j(s) = \rho^j_0\,Q^j(s) + \sum_k m^j(\tau_k)\,q^j(s,\tau_k)\,\Delta\tau_k\)  (quadrature of the integral)" vertex="1">
                    <mxGeometry height="60" width="480" x="340" y="440" as="geometry"/>
                </mxCell>
                <mxCell id="ev4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;5.&lt;/b&gt; Stress: \(\boldsymbol\sigma(s) = \frac{1}{J}\sum_j\Big[\rho^j_0 Q^j\,\frac{\partial W^j(s,0)}{\partial\mathbf F}\mathbf F^T + \sum_k m^j q^j\,\frac{\partial W^j(s,\tau_k)}{\partial\mathbf F}\mathbf F^T\,\Delta\tau_k\Big]\)" vertex="1">
                    <mxGeometry height="80" width="480" x="340" y="525" as="geometry"/>
                </mxCell>
                <mxCell id="ev5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;6.&lt;/b&gt; Tangent \(\partial\boldsymbol\sigma/\partial\mathbf F\): sum over all cohorts" vertex="1">
                    <mxGeometry height="50" width="480" x="340" y="630" as="geometry"/>
                </mxCell>
                <mxCell id="fe3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#eeeeee;strokeColor=#666666;" value="assemble residual and tangent; converged?" vertex="1">
                    <mxGeometry height="80" width="170" x="70" y="620" as="geometry"/>
                </mxCell>
                <mxCell id="fe4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#eeeeee;strokeColor=#666666;" value="Converged: commit the state at every Gauss point" vertex="1">
                    <mxGeometry height="60" width="230" x="40" y="765" as="geometry"/>
                </mxCell>
                <mxCell id="h_co" parent="1" style="text;html=1;align=left;verticalAlign=bottom;fontSize=13;fontStyle=1;" value="Gauss point: state update after convergence (commit)" vertex="1">
                    <mxGeometry height="30" width="480" x="340" y="725" as="geometry"/>
                </mxCell>
                <mxCell id="co0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#f2f8f0;strokeColor=#82b366;" value="&lt;b&gt;7.&lt;/b&gt; Append the converged \(\mathbf F(s)\) and \(m^j(s)\) to the history: one new cohort per step" vertex="1">
                    <mxGeometry height="55" width="480" x="340" y="765" as="geometry"/>
                </mxCell>
                <mxCell id="co1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#f2f8f0;strokeColor=#82b366;" value="&lt;b&gt;8.&lt;/b&gt; Optionally drop cohorts with \(q^j \approx 0\)" vertex="1">
                    <mxGeometry height="45" width="480" x="340" y="845" as="geometry"/>
                </mxCell>
                <mxCell id="h_st" parent="1" style="text;html=1;align=left;verticalAlign=bottom;fontSize=13;fontStyle=1;" value="Stored state per Gauss point" vertex="1">
                    <mxGeometry height="30" width="300" x="900" y="150" as="geometry"/>
                </mxCell>
                <mxCell id="st" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;align=left;spacingLeft=8;spacingRight=8;fillColor=#ffffff;strokeColor=#666666;dashed=1;verticalAlign=top;spacingTop=8;" value="whole history: \(\mathbf F(\tau_k)\), \(m^j(\tau_k)\) of all past steps&lt;br&gt;\(\rho^j_0\), \(\mathbf G^j\), \(W^j\), \(T^j\)&lt;br&gt;&lt;br&gt;grows with every step" vertex="1">
                    <mxGeometry height="160" width="300" x="900" y="190" as="geometry"/>
                </mxCell>
                <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=12;spacingRight=12;fontSize=12;arcSize=6;" value="&lt;b&gt;Cost:&lt;/b&gt; every stress evaluation loops over all stored cohorts; memory and time grow with the number of steps.&lt;br&gt;&lt;b&gt;With growth:&lt;/b&gt; \(\mathbf F(s) \to \mathbf F(s)\mathbf F_g^{-1}(s)\) and \(\mathbf F(\tau_k) \to \mathbf F(\tau_k)\mathbf F_g^{-1}(\tau_k)\), \(\mathbf F_g\) from \(\rho_{tot}\).&lt;br&gt;&lt;b&gt;Natural configurations:&lt;/b&gt; one per cohort, set by \(\mathbf F(\tau_k)\) and \(\mathbf G^j\)." vertex="1">
                    <mxGeometry height="90" width="1160" x="40" y="940" as="geometry"/>
                </mxCell>
                <mxCell id="a1" edge="1" parent="1" source="fe1" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" target="fe2" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a2" edge="1" parent="1" source="fe2" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontSize=13;" target="ev0" value="\(\mathbf F(s)\)">
                    <mxGeometry relative="1" as="geometry"/>

                <mxCell id="cm2b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f8f0;strokeColor=#82b366;fontSize=12;arcSize=12;" value="\(\mathbf G^j\): deposition prestretch, new mass is laid down already stretched → prestress" vertex="1">

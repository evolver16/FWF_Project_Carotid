                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a_ev4" edge="1" parent="1" source="ev4" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" target="ev5" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a3" edge="1" parent="1" source="ev5" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontSize=13;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="fe3" value="\(\boldsymbol\sigma\), \(\partial\boldsymbol\sigma/\partial\mathbf F\)">
                    <mxGeometry relative="1" as="geometry"/>

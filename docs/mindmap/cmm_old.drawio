    <diagram id="cmm" name="Constrained mixture">
        <mxGraphModel dx="1012" dy="1073" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="1" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" value="&lt;b&gt;Constrained mixture (Humphrey &amp;amp; Rajagopal 2002):&lt;/b&gt; mass of constituent \(j\) deposited at time \(\tau\)" vertex="1">
                    <mxGeometry height="40" width="900" x="40" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="b0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="&lt;b&gt;Reference \(\mathcal B_0\)&lt;/b&gt;&lt;br&gt;\(s = 0\)" vertex="1">
                    <mxGeometry height="80" width="160" x="60" y="220" as="geometry"/>
                </mxCell>
                <mxCell id="bt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="&lt;b&gt;Tissue at deposition \(\mathcal B(\tau)\)&lt;/b&gt;&lt;br&gt;new mass is laid down here" vertex="1">
                    <mxGeometry height="80" width="180" x="400" y="220" as="geometry"/>
                </mxCell>
                <mxCell id="bs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="&lt;b&gt;Current tissue \(\mathcal B(s)\)&lt;/b&gt;" vertex="1">
                    <mxGeometry height="80" width="180" x="780" y="220" as="geometry"/>
                </mxCell>
                <mxCell id="kn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;fontSize=13;" value="&lt;b&gt;Natural configuration&lt;/b&gt; of the mass deposited at \(\tau\)&lt;br&gt;stress-free, one per cohort \(\tau\)" vertex="1">
                    <mxGeometry height="80" width="180" x="400" y="430" as="geometry"/>
                </mxCell>
                <mxCell id="f_t" edge="1" parent="1" source="b0" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#333333;fontSize=15;labelBackgroundColor=#ffffff;" target="bt" value="\(\mathbf F(\tau)\)">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f_ts" edge="1" parent="1" source="bt" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#333333;fontSize=14;labelBackgroundColor=#ffffff;" target="bs" value="\(\mathbf F(s)\,\mathbf F^{-1}(\tau)\)&lt;br&gt;deformation since deposition">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f_s" edge="1" parent="1" source="b0" style="edgeStyle=orthogonalEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;strokeColor=#333333;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" target="bs" value="\(\mathbf F(s)\)  total">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="140" y="130"/>
                            <mxPoint x="870" y="130"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="f_g" edge="1" parent="1" source="kn" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#82b366;fontSize=14;labelBackgroundColor=#ffffff;" target="bt" value="\(\mathbf G^j\)  deposition prestretch">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f_e" edge="1" parent="1" source="kn" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#b85450;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=1;edgeStyle=orthogonalEdgeStyle;curved=1;" target="bs" value="\(\mathbf F_e^j(s,\tau) = \mathbf F(s)\,\mathbf F^{-1}(\tau)\,\mathbf G^j\)&lt;br&gt;causes the stress of this cohort">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=12;arcSize=6;" value="&lt;b&gt;Every cohort \(\tau\) has its own natural configuration.&lt;/b&gt; Mass: \(\rho^j(s) = \rho^j_0 Q^j(s) + \int_0^s m^j(\tau)\,q^j(s,\tau)\,d\tau\); the initial mass is the cohort \(\tau = 0\) with \(\mathbf F_e^j = \mathbf F(s)\,\mathbf G^j\).&lt;br&gt;Stress \(\boldsymbol\sigma^j(s)\): integral over all surviving cohorts → \(\mathbf F(\tau)\) of the whole history must be stored (memory, cost) → motivation for the HCMM.&lt;br&gt;Extended by growth: \(\mathbf F(s) \to \mathbf F(s)\mathbf F_g^{-1}(s)\) and \(\mathbf F(\tau) \to \mathbf F(\tau)\mathbf F_g^{-1}(\tau)\)." vertex="1">
                    <mxGeometry height="90" width="960" x="40" y="570" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>

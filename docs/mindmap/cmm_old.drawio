                <mxCell id="cm2c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f8f0;strokeColor=#82b366;fontSize=12;arcSize=12;" value="classical CMM: mass change without inelastic volume change; extended by growth:&lt;br&gt;\(\mathbf F_e^j = \mathbf F(s)\mathbf F_g^{-1}(s)\,[\mathbf F(\tau)\mathbf F_g^{-1}(\tau)]^{-1}\,\mathbf G^j\)" vertex="1">

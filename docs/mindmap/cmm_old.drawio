                <mxCell id="cm1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f8f0;strokeColor=#82b366;fontSize=12;arcSize=20;" value="Constituents \(j\) (e.g. elastin, collagen, smooth muscle): own material, mass \(\rho^j\) and natural configuration; constrained to move together with one \(\mathbf F\)" vertex="1">
                    <mxGeometry height="70" width="280" x="590" y="130" as="geometry"/>
                </mxCell>
                <UserObject label="&lt;b&gt;Mass deposited at time \(\tau\)&lt;/b&gt;&lt;br&gt;\(\mathbf F_e^j(s,\tau) = \mathbf F(s)\,\mathbf F^{-1}(\tau)\,\mathbf G^j\)&lt;br&gt;&lt;i&gt;diagram: page Constrained mixture&lt;/i&gt;" link="data:page/id,cmm" id="cm2">
                    <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=20;" vertex="1">
